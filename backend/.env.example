# Existing AHOY backend settings
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ORIGIN=https://YOUR-FRONTEND-DOMAIN
PORT=3000

# Dedicated AHOY Universal Downloader service
DOWNLOADER_SERVICE_URL=https://YOUR-DOWNLOADER-SERVICE.onrender.com
DOWNLOADER_SERVICE_SECRET=USE_THE_SAME_LONG_RANDOM_SECRET_AS_AHOY_DOWNLOADER_SECRET

# Optional Roblox OAuth settings (required only if Roblox connect/upload is enabled)
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_REDIRECT_URI=
ROBLOX_TOKEN_ENCRYPTION_KEY=
